# ScreenLab environment variables
# Copy this file to .env.local for local development, and add the same two
# variables in Vercel → Project → Settings → Environment Variables.
#
# Both values come from Supabase → Project Settings → API (or "Connect").
# The anon / publishable key is SAFE to expose in the browser: your data is
# protected by Row Level Security policies in the database.
#
# NEVER put the service_role / secret key here.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
